{
  "name": "wax-pop-ball",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "왁뿌볼 공방: iPad용 3D 점토 색 섞기와 누르기 놀이",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "serve dist --single --no-clipboard --listen tcp://0.0.0.0:${PORT:-3000}"
  },
  "dependencies": {
    "mixbox": "^2.0.0",
    "serve": "^14.2.6",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
